{
  "applicationId": "js.neutralino.nwrite",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeBlocklist": [],
  "permissions": [
    "filesystem",
    "os"
  ],
  "modes": {
    "window": {
      "title": "NWrite",
      "width": 1000,
      "height": 700,
      "minWidth": 400,
      "minHeight": 300
    }
  },
  "cli": {
    "binaryName": "nwrite-portable",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js"
  }
}
